<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>disabled-by-conformance</mirrorOf>
      <url>http://0.0.0.0/</url>
    </mirror>
    <!-- One URL for everything: the group serves both what this registry
         hosts and what it proxies. -->
    <mirror>
      <id>registry</id>
      <mirrorOf>*</mirrorOf>
      <url>http://registry:8080/maven/maven-public</url>
    </mirror>
  </mirrors>
</settings>
