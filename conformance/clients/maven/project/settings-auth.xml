<?xml version="1.0" encoding="UTF-8"?>
<!-- Standard Maven credential form: <server> username/password, which
     maven-resolver sends as HTTP Basic. The password is the registry token,
     injected from the REGISTRY_TOKEN environment variable. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <servers>
    <server>
      <id>registry-private</id>
      <username>ci</username>
      <password>${env.REGISTRY_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>disabled-by-conformance</mirrorOf>
      <url>http://0.0.0.0/</url>
    </mirror>
    <mirror>
      <id>registry-private</id>
      <mirrorOf>*</mirrorOf>
      <url>http://registry:8080/maven/private</url>
    </mirror>
  </mirrors>
</settings>
