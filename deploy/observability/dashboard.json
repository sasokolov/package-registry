{
  "title": "Package registry",
  "uid": "fondaco",
  "tags": [
    "registry",
    "geo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by source",
      "description": "cache/upstream/stale/local/peer \u2014 every response is labelled (invariant 11).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(fondaco_requests_total[5m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(fondaco_requests_total{source=~\"cache|local\"}[5m])) / clamp_min(sum(rate(fondaco_requests_total[5m])), 0.001)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50/p95/p99",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fondaco_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fondaco_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fondaco_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Upstream breaker state",
      "description": "0 closed, 1 half-open, 2 open. Open means stale-while-revalidate is carrying the feed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_upstream_breaker_state",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Replication lag (events behind)",
      "description": "How many journal entries this site still has to apply.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_repl_lag",
          "legendFormat": "{{peer}} / {{origin}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Durability lag (RPO)",
      "description": "Applied manifests whose blobs are not local yet: what would be unservable if this site had to take over now.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_repl_durable_lag",
          "legendFormat": "{{peer}} / {{origin}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Seconds since last successful peer poll",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_repl_cursor_age_seconds",
          "legendFormat": "{{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replication events applied",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(fondaco_repl_applied_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Publish conflicts (rule K1)",
      "description": "Non-zero means a coordinate is quarantined and NOT being served until an operator resolves it.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "increase(fondaco_repl_publish_conflicts_total[1h])",
          "legendFormat": "conflicts/h",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Parked events",
      "description": "Events waiting for a retry: unknown kind, missing blob, or clock skew.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_repl_parked_events",
          "legendFormat": "parked",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Feed digest per site (divergence detector)",
      "description": "Sites that agree report identical values. A lasting difference is silent divergence \u2014 the thing invariant 16 exists to make visible.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "fondaco_repl_feed_digest",
          "legendFormat": "{{feed}} @ {{site}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Storage per feed",
      "description": "What each feed's content occupies. Blobs are shared, so feeds sum to more than the store holds \u2014 fondaco_store_bytes is the bill.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (feed) (fondaco_feed_bytes)",
          "legendFormat": "{{feed}}",
          "refId": "A"
        },
        {
          "expr": "fondaco_store_bytes",
          "legendFormat": "site total (deduplicated)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Packages per feed",
      "description": "Distinct coordinates, hosted and cached. A proxy feed's number is what it has actually cached, not what its upstream offers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (feed, kind) (fondaco_feed_packages)",
          "legendFormat": "{{feed}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Downloads per feed",
      "description": "Responses served. A proxy feed that stores a lot and serves little is a disk bill nobody has looked at.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (feed) (rate(fondaco_requests_total[5m]))",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Bytes served vs pulled from upstream",
      "description": "The gap is what the cache saved. A proxy feed where they track each other is caching nothing useful.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(fondaco_bytes_served_total[5m]))",
          "legendFormat": "served",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fondaco_upstream_bytes_total[5m]))",
          "legendFormat": "pulled from upstreams",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Group traffic by answering member",
      "description": "Which member of a group actually answers. A group that only ever answers from one member is worth a look.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (group, member) (rate(fondaco_group_requests_total[5m]))",
          "legendFormat": "{{group}} \u2190 {{member}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Days since a feed last stored anything",
      "description": "A proxy feed that has gone quiet is either unused or broken, and this is how the two are told apart.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "(time() - fondaco_feed_last_ingest_timestamp_seconds) / 86400",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ]
    }
  ]
}
